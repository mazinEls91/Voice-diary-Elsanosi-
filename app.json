{
  "expo": {
    "name": "Voice Diary",
    "slug": "voice-diary-elsanosi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.elsanosi.voicediary",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Voice Diary needs microphone access to record your audio entries."
      }
    },
    "android": {
      "package": "com.elsanosi.voicediary",
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      "expo-av",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "scheme": "voicediary"
  }
}
